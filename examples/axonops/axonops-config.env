# AxonOps self-hosted configuration, read by axonops-setup.sh.
#
#   source axonops-config.env
#   export AXON_SEARCH_PASSWORD="$(openssl rand -base64 24)"
#   export AXON_SERVER_CQL_PASSWORD="$(openssl rand -base64 24)"
#   ./axonops-setup.sh
#
# Every setting the script reads is listed here with its default. Edit the
# values, or export overrides before sourcing: a variable that is already set
# keeps its value. Start a new shell to drop earlier overrides. Commented-out
# settings are derived by the script; uncomment one only to override it.
#
# The Strimzi and K8ssandra examples read AXONOPS_NAMESPACE,
# AXON_SERVER_ORG_NAME and AXON_SERVER_AGENTS_PORT from this file to find the
# AxonOps server, so source it in the same shell before theirs.

# --- Render only (no changes to the cluster) ---
# true: write the Helm values files and the axon-server Secret to
# AXONOPS_OUTPUT_DIR (default ./generated) and print the helm and kubectl
# commands a real run would execute. Nothing is installed or applied.
#   RENDER_ONLY=true ./axonops-setup.sh
export RENDER_ONLY="${RENDER_ONLY:-false}"

# --- Namespaces and tools ---
# Namespace for every AxonOps component.
export AXONOPS_NAMESPACE="${AXONOPS_NAMESPACE:-axonops}"
export NS_CERT_MANAGER="${NS_CERT_MANAGER:-cert-manager}"
export KUBECTL_BIN="${KUBECTL_BIN:-kubectl}"
export HELM_BIN="${HELM_BIN:-helm}"
# Timeout for each helm upgrade --install.
export HELM_TIMEOUT="${HELM_TIMEOUT:-10m}"
# true: helm --wait on every AxonOps release, so the script returns only when
# all pods are ready. false: install without waiting. cert-manager always waits.
export HELM_WAIT="${HELM_WAIT:-true}"
# Default: generated/ next to the script. Holds passwords.
# export AXONOPS_OUTPUT_DIR="./generated"

# --- cert-manager ---
# cert-manager is only used when a database has TLS enabled (off by default).
# An installed cert-manager is always detected and reused, never reinstalled.
# true: install cert-manager when it is missing. false: stop if it is missing.
export CERT_MANAGER_INSTALL="${CERT_MANAGER_INSTALL:-false}"
# Create CLUSTER_ISSUER_NAME as a self-signed ClusterIssuer if it does not
# exist. An existing issuer is used as it is and never modified.
export CLUSTER_ISSUER_CREATE="${CLUSTER_ISSUER_CREATE:-true}"
export CERT_MANAGER_RELEASE_NAME="${CERT_MANAGER_RELEASE_NAME:-cert-manager}"
export CERT_MANAGER_CHART_REPO="${CERT_MANAGER_CHART_REPO:-oci://quay.io/jetstack/charts/cert-manager}"
export CERT_MANAGER_VERSION="${CERT_MANAGER_VERSION:-v1.19.1}"
# Issuer for the database certificates and the Ingress annotations.
export CLUSTER_ISSUER_NAME="${CLUSTER_ISSUER_NAME:-selfsigned-cluster-issuer}"

# --- axon-server ---
# Organisation name. Agents must use the same value as AXON_AGENT_ORG.
export AXON_SERVER_ORG_NAME="${AXON_SERVER_ORG_NAME:-example}"
export AXON_SERVER_AGENTS_PORT="${AXON_SERVER_AGENTS_PORT:-1888}"
export AXON_SERVER_API_PORT="${AXON_SERVER_API_PORT:-8080}"
export AXON_SERVER_LICENSE_KEY="${AXON_SERVER_LICENSE_KEY:-}"
# Agent port TLS mode.
export AXON_SERVER_TLS_MODE="${AXON_SERVER_TLS_MODE:-disabled}"
export AXON_SERVER_AUTH_ENABLED="${AXON_SERVER_AUTH_ENABLED:-false}"
export AXON_SERVER_RELEASE_NAME="${AXON_SERVER_RELEASE_NAME:-axon-server}"
# Chart reference or a local path, e.g. ../../axonops/charts/axon-server.
export AXON_SERVER_CHART="${AXON_SERVER_CHART:-oci://ghcr.io/axonops/charts/axon-server}"
export AXON_SERVER_SECRET_NAME="${AXON_SERVER_SECRET_NAME:-axon-server-config}"
export AXON_SERVER_HELM_EXTRA_ARGS="${AXON_SERVER_HELM_EXTRA_ARGS:-}"
export AXON_SERVER_SEARCH_DB_SKIP_VERIFY="${AXON_SERVER_SEARCH_DB_SKIP_VERIFY:-true}"
export AXON_SERVER_CQL_LOCAL_DC="${AXON_SERVER_CQL_LOCAL_DC:-axonopsdb_dc1}"
export AXON_SERVER_CQL_SKIP_VERIFY="${AXON_SERVER_CQL_SKIP_VERIFY:-true}"
# export AXON_SERVER_CQL_SSL_ENABLED="false"
# Default: derived from the release name and namespace.
# export AXON_SERVER_CQL_HOSTS="axondb-timeseries-headless.axonops.svc.cluster.local"
# Default: derived from the namespace; http when AXON_SEARCH_TLS_ENABLED=false.
# export AXON_SERVER_SEARCH_DB_HOST_URL="https://axondb-search-cluster-master.axonops.svc.cluster.local:9200"
# Default: derived from the axon-dash release name and namespace.
# export AXON_SERVER_REPORTING_URL="http://axon-dash-svc.axonops.svc.cluster.local:8081"

# --- Database credentials ---
export AXON_SEARCH_USER="${AXON_SEARCH_USER:-admin}"
# Required. Export it rather than writing it here:
#   export AXON_SEARCH_PASSWORD="$(openssl rand -base64 24)"
export AXON_SEARCH_PASSWORD="${AXON_SEARCH_PASSWORD:-}"
export AXON_SERVER_CQL_USERNAME="${AXON_SERVER_CQL_USERNAME:-axonops}"
# Required. Export it rather than writing it here:
#   export AXON_SERVER_CQL_PASSWORD="$(openssl rand -base64 24)"
export AXON_SERVER_CQL_PASSWORD="${AXON_SERVER_CQL_PASSWORD:-}"

# --- AxonDB Timeseries (Cassandra) ---
export AXON_TIMESERIES_RELEASE_NAME="${AXON_TIMESERIES_RELEASE_NAME:-axondb-timeseries}"
export AXON_TIMESERIES_CHART="${AXON_TIMESERIES_CHART:-oci://ghcr.io/axonops/charts/axondb-timeseries}"
export AXON_TIMESERIES_HEAP_SIZE="${AXON_TIMESERIES_HEAP_SIZE:-2048M}"
# TLS on the database, off by default. When on, axon-server connects with TLS
# and the certificate comes from cert-manager or AXON_TIMESERIES_TLS_EXISTING_SECRET.
export AXON_TIMESERIES_TLS_ENABLED="${AXON_TIMESERIES_TLS_ENABLED:-false}"
# Issue the TLS certificate with cert-manager. With TLS enabled, either this
# or AXON_TIMESERIES_TLS_EXISTING_SECRET is required, or the database starts
# without TLS and axon-server cannot connect; the script refuses to run then.
export AXON_TIMESERIES_CERTMANAGER_ENABLED="${AXON_TIMESERIES_CERTMANAGER_ENABLED:-true}"
# Existing Secret with the TLS material, used when cert-manager is not.
export AXON_TIMESERIES_TLS_EXISTING_SECRET="${AXON_TIMESERIES_TLS_EXISTING_SECRET:-}"
export AXON_TIMESERIES_CERT_ISSUER_NAME="${AXON_TIMESERIES_CERT_ISSUER_NAME:-$CLUSTER_ISSUER_NAME}"
# false keeps data only for the life of the pod.
export AXON_TIMESERIES_PERSISTENCE_ENABLED="${AXON_TIMESERIES_PERSISTENCE_ENABLED:-true}"
# Empty: the cluster default StorageClass.
export AXON_TIMESERIES_STORAGE_CLASS="${AXON_TIMESERIES_STORAGE_CLASS:-}"
export AXON_TIMESERIES_VOLUME_SIZE="${AXON_TIMESERIES_VOLUME_SIZE:-10Gi}"
# Store data in a hostPath directory instead of a PVC. Single-node clusters only.
export AXON_TIMESERIES_USE_HOSTPATH="${AXON_TIMESERIES_USE_HOSTPATH:-false}"
export AXON_TIMESERIES_HOSTPATH_DIR="${AXON_TIMESERIES_HOSTPATH_DIR:-/data/axon-timeseries}"
# Create the directory with sudo on the machine running the script.
export AXON_TIMESERIES_HOSTPATH_CREATE="${AXON_TIMESERIES_HOSTPATH_CREATE:-false}"
export AXON_TIMESERIES_HOST_UID="${AXON_TIMESERIES_HOST_UID:-999}"
export AXON_TIMESERIES_HOST_GID="${AXON_TIMESERIES_HOST_GID:-999}"
export AXON_TIMESERIES_CONTAINER_MOUNT_PATH="${AXON_TIMESERIES_CONTAINER_MOUNT_PATH:-/var/lib/cassandra}"
export AXON_TIMESERIES_RES_REQ_CPU="${AXON_TIMESERIES_RES_REQ_CPU:-1000m}"
export AXON_TIMESERIES_RES_REQ_MEM="${AXON_TIMESERIES_RES_REQ_MEM:-2Gi}"
export AXON_TIMESERIES_RES_LIMIT_CPU="${AXON_TIMESERIES_RES_LIMIT_CPU:-2000m}"
export AXON_TIMESERIES_RES_LIMIT_MEM="${AXON_TIMESERIES_RES_LIMIT_MEM:-4Gi}"
export AXON_TIMESERIES_HELM_EXTRA_ARGS="${AXON_TIMESERIES_HELM_EXTRA_ARGS:-}"

# --- AxonDB Search (OpenSearch) ---
export AXON_SEARCH_RELEASE_NAME="${AXON_SEARCH_RELEASE_NAME:-axondb-search}"
export AXON_SEARCH_CHART="${AXON_SEARCH_CHART:-oci://ghcr.io/axonops/charts/axondb-search}"
export AXON_SEARCH_HEAP_SIZE="${AXON_SEARCH_HEAP_SIZE:-2g}"
# TLS on the database, off by default. When on, axon-server connects with TLS
# and the certificate comes from cert-manager or AXON_SEARCH_TLS_EXISTING_SECRET.
export AXON_SEARCH_TLS_ENABLED="${AXON_SEARCH_TLS_ENABLED:-false}"
# Issue the TLS certificate with cert-manager. With neither this nor
# AXON_SEARCH_TLS_EXISTING_SECRET, the certificates built into the image are used.
export AXON_SEARCH_CERTMANAGER_ENABLED="${AXON_SEARCH_CERTMANAGER_ENABLED:-true}"
# Existing Secret with the TLS material, used when cert-manager is not.
export AXON_SEARCH_TLS_EXISTING_SECRET="${AXON_SEARCH_TLS_EXISTING_SECRET:-}"
export AXON_SEARCH_CERT_ISSUER_NAME="${AXON_SEARCH_CERT_ISSUER_NAME:-$CLUSTER_ISSUER_NAME}"
# false keeps data only for the life of the pod.
export AXON_SEARCH_PERSISTENCE_ENABLED="${AXON_SEARCH_PERSISTENCE_ENABLED:-true}"
# Empty: the cluster default StorageClass.
export AXON_SEARCH_STORAGE_CLASS="${AXON_SEARCH_STORAGE_CLASS:-}"
export AXON_SEARCH_VOLUME_SIZE="${AXON_SEARCH_VOLUME_SIZE:-10Gi}"
# Store data in a hostPath directory instead of a PVC. Single-node clusters only.
export AXON_SEARCH_USE_HOSTPATH="${AXON_SEARCH_USE_HOSTPATH:-false}"
export AXON_SEARCH_HOSTPATH_DIR="${AXON_SEARCH_HOSTPATH_DIR:-/data/axon-search}"
# Create the directory with sudo on the machine running the script.
export AXON_SEARCH_HOSTPATH_CREATE="${AXON_SEARCH_HOSTPATH_CREATE:-false}"
export AXON_SEARCH_HOST_UID="${AXON_SEARCH_HOST_UID:-999}"
export AXON_SEARCH_HOST_GID="${AXON_SEARCH_HOST_GID:-999}"
export AXON_SEARCH_CONTAINER_MOUNT_PATH="${AXON_SEARCH_CONTAINER_MOUNT_PATH:-/var/lib/opensearch}"
export AXON_SEARCH_HELM_EXTRA_ARGS="${AXON_SEARCH_HELM_EXTRA_ARGS:-}"

# --- axon-dash ---
export AXON_DASH_RELEASE_NAME="${AXON_DASH_RELEASE_NAME:-axon-dash}"
export AXON_DASH_CHART="${AXON_DASH_CHART:-oci://ghcr.io/axonops/charts/axon-dash}"
export AXON_DASH_SERVICE_TYPE="${AXON_DASH_SERVICE_TYPE:-ClusterIP}"
export AXON_DASH_SERVICE_PORT="${AXON_DASH_SERVICE_PORT:-3000}"
# true: NodePort Service; the script prints the assigned port.
export AXON_DASH_NODEPORT_ENABLED="${AXON_DASH_NODEPORT_ENABLED:-false}"
export AXON_DASH_HELM_EXTRA_ARGS="${AXON_DASH_HELM_EXTRA_ARGS:-}"
# Reports v2 axon-reporting sidecar (axon-server >= 2.0.39).
export AXON_DASH_REPORTING_IMAGE_REPOSITORY="${AXON_DASH_REPORTING_IMAGE_REPOSITORY:-registry.axonops.com/axonops-public/axonops-docker/axon-reporting}"
export AXON_DASH_REPORTING_IMAGE_TAG="${AXON_DASH_REPORTING_IMAGE_TAG:-1.0.3}"
export AXON_DASH_REPORTING_PORT="${AXON_DASH_REPORTING_PORT:-8081}"
# Default: derived from the axon-server release name and namespace.
# export AXON_DASH_AXON_SERVER_URL="http://axon-server-api.axonops.svc.cluster.local:8080"

# --- Ingress ---
export AXON_DASH_INGRESS_ENABLED="${AXON_DASH_INGRESS_ENABLED:-false}"
export AXON_DASH_INGRESS_CLASS_NAME="${AXON_DASH_INGRESS_CLASS_NAME:-}"
export AXON_DASH_INGRESS_HOST="${AXON_DASH_INGRESS_HOST:-axonops.example.com}"
export AXON_DASH_INGRESS_TLS_SECRET_NAME="${AXON_DASH_INGRESS_TLS_SECRET_NAME:-axon-dash-tls}"
# cert-manager ClusterIssuer annotation for the Ingress, e.g. selfsigned-cluster-issuer. Empty: none.
export AXON_DASH_INGRESS_CERT_ISSUER_ANNOTATION="${AXON_DASH_INGRESS_CERT_ISSUER_ANNOTATION:-}"
export AXON_SERVER_API_INGRESS_ENABLED="${AXON_SERVER_API_INGRESS_ENABLED:-false}"
export AXON_SERVER_API_INGRESS_CLASS_NAME="${AXON_SERVER_API_INGRESS_CLASS_NAME:-}"
export AXON_SERVER_API_INGRESS_HOST="${AXON_SERVER_API_INGRESS_HOST:-api.example.com}"
export AXON_SERVER_API_INGRESS_TLS_SECRET_NAME="${AXON_SERVER_API_INGRESS_TLS_SECRET_NAME:-axon-server-api-tls}"
# cert-manager ClusterIssuer annotation for the Ingress, e.g. selfsigned-cluster-issuer. Empty: none.
export AXON_SERVER_API_INGRESS_CERT_ISSUER_ANNOTATION="${AXON_SERVER_API_INGRESS_CERT_ISSUER_ANNOTATION:-}"
export AXON_SERVER_AGENT_INGRESS_ENABLED="${AXON_SERVER_AGENT_INGRESS_ENABLED:-false}"
export AXON_SERVER_AGENT_INGRESS_CLASS_NAME="${AXON_SERVER_AGENT_INGRESS_CLASS_NAME:-nginx}"
export AXON_SERVER_AGENT_INGRESS_HOST="${AXON_SERVER_AGENT_INGRESS_HOST:-agents.example.com}"
export AXON_SERVER_AGENT_INGRESS_TLS_SECRET_NAME="${AXON_SERVER_AGENT_INGRESS_TLS_SECRET_NAME:-axon-server-agents-tls}"
# cert-manager ClusterIssuer annotation for the Ingress, e.g. selfsigned-cluster-issuer. Empty: none.
export AXON_SERVER_AGENT_INGRESS_CERT_ISSUER_ANNOTATION="${AXON_SERVER_AGENT_INGRESS_CERT_ISSUER_ANNOTATION:-}"
# Add nginx.ingress.kubernetes.io/backend-protocol: GRPC.
export AXON_SERVER_AGENT_INGRESS_GRPC_ANNOTATION="${AXON_SERVER_AGENT_INGRESS_GRPC_ANNOTATION:-true}"
