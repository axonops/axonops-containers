# K8ssandra Cassandra cluster with the AxonOps agent.
#
#   source k8ssandra-config.env
#   envsubst < axonops-agent-secret.yaml | kubectl apply -f -
#   envsubst < cluster-axonops-ubi.yaml | kubectl apply -f -
#
# Edit the values here, or export overrides before sourcing: a variable
# that is already set keeps its value, and values derived from it follow.
# Start a new shell to drop earlier overrides.

# --- Kubernetes ---
# The K8ssandra operator only watches its own namespace unless it was installed
# with --set global.clusterScoped=true. Keep these equal in that case.
export K8SSANDRA_OPERATOR_NAMESPACE="${K8SSANDRA_OPERATOR_NAMESPACE:-k8ssandra-operator}"
export K8SSANDRA_NAMESPACE="${K8SSANDRA_NAMESPACE:-k8ssandra-operator}"
export K8SSANDRA_CLUSTER_NAME="${K8SSANDRA_CLUSTER_NAME:-my-cassandra}"

# --- Cassandra ---
# Tags: <cassandra>-v<k8ssandra api>-<image>. See https://github.com/axonops/axonops-containers/pkgs/container/k8ssandra%2Fcassandra
# The default <cassandra> tag is floating: it always points to the latest
# AxonOps build for that Cassandra version, which suits a demo. In production,
# pin the image by SHA256 digest so every node runs the same build:
#   IMAGE_NAME=ghcr.io/axonops/k8ssandra/cassandra@sha256:<digest>
export CASSANDRA_VERSION="${CASSANDRA_VERSION:-5.0.9}"
export IMAGE_NAME="${IMAGE_NAME:-ghcr.io/axonops/k8ssandra/cassandra:${CASSANDRA_VERSION}}"
export CASSANDRA_DC_NAME="${CASSANDRA_DC_NAME:-dc1}"
export CASSANDRA_DC_SIZE="${CASSANDRA_DC_SIZE:-3}"

# --- Storage ---
# An empty storage class uses the cluster default.
export STORAGE_CLASS="${STORAGE_CLASS:-}"
export STORAGE_SIZE="${STORAGE_SIZE:-10Gi}"
# AxonOps agent state, mounted at /var/lib/axonops.
export AXONOPS_STORAGE_SIZE="${AXONOPS_STORAGE_SIZE:-2Gi}"

# --- Resources ---
export CPU_REQUEST="${CPU_REQUEST:-1}"
export CPU_LIMIT="${CPU_LIMIT:-2}"
export MEMORY_REQUEST="${MEMORY_REQUEST:-2Gi}"
export MEMORY_LIMIT="${MEMORY_LIMIT:-4Gi}"
export HEAP_SIZE="${HEAP_SIZE:-1G}"

# --- AxonOps agent ---
# AxonOps Cloud (default): organisation and agent key from the AxonOps Cloud
# console. Export the key before or after sourcing rather than writing it here.
export AXON_AGENT_ORG="${AXON_AGENT_ORG:-your-org}"
export AXON_AGENT_KEY="${AXON_AGENT_KEY:-}"
export AXON_AGENT_SERVER_HOST="${AXON_AGENT_SERVER_HOST:-agents.axonops.cloud}"
export AXON_AGENT_SERVER_PORT="${AXON_AGENT_SERVER_PORT:-443}"
export AXON_AGENT_TLS_MODE="${AXON_AGENT_TLS_MODE:-TLS}"

# Self-hosted AxonOps server (../axonops/): source ../axonops/axonops-config.env
# first, then uncomment these lines.
# export AXON_AGENT_ORG="${AXON_SERVER_ORG_NAME:-example}"
# export AXON_AGENT_KEY="not-used"
# export AXON_AGENT_SERVER_HOST="axon-server-agent.${AXONOPS_NAMESPACE:-axonops}.svc.cluster.local"
# export AXON_AGENT_SERVER_PORT="${AXON_SERVER_AGENTS_PORT:-1888}"
# export AXON_AGENT_TLS_MODE="disabled"
