# Strimzi Kafka with the AxonOps agent, reporting to a self-hosted AxonOps
# server (see ../../axonops/).
#
#   source strimzi-config.env
#
# Edit the values here, or export overrides before sourcing: a variable
# that is already set keeps its value, and values derived from it follow.
# Start a new shell to drop earlier overrides.

# --- Kubernetes ---
export KAFKA_NAMESPACE="${KAFKA_NAMESPACE:-kafka}"
export STRIMZI_CLUSTER_NAME="${STRIMZI_CLUSTER_NAME:-my-cluster}"
# Node label used for rack awareness and to spread pods. Every node has
# kubernetes.io/hostname; use topology.kubernetes.io/zone if your nodes carry it.
export KAFKA_RACK_TOPOLOGY_KEY="${KAFKA_RACK_TOPOLOGY_KEY:-kubernetes.io/hostname}"

# --- Kafka ---
# Tags: <strimzi>-<kafka>-<agent>-<image>. See https://github.com/axonops/axonops-containers/pkgs/container/strimzi%2Fkafka
# The default <strimzi>-<kafka> tag is floating: it always points to the latest
# AxonOps build for that Strimzi and Kafka version, which suits a demo. In
# production, pin the image by SHA256 digest so every broker runs the same build:
#   KAFKA_CONTAINER_IMAGE=ghcr.io/axonops/strimzi/kafka@sha256:<digest>
export KAFKA_VERSION="${KAFKA_VERSION:-4.3.0}"
export KAFKA_CONTAINER_IMAGE="${KAFKA_CONTAINER_IMAGE:-ghcr.io/axonops/strimzi/kafka:1.1.0-${KAFKA_VERSION}}"
export KAFKA_REPLICATION_FACTOR="${KAFKA_REPLICATION_FACTOR:-3}"
export KAFKA_MIN_INSYNC_REPLICAS="${KAFKA_MIN_INSYNC_REPLICAS:-2}"

# --- Node pools ---
# An empty storage class uses the cluster default.
export STRIMZI_CONTROLLER_REPLICAS="${STRIMZI_CONTROLLER_REPLICAS:-3}"
export STRIMZI_CONTROLLER_STORAGE_SIZE="${STRIMZI_CONTROLLER_STORAGE_SIZE:-10Gi}"
export STRIMZI_CONTROLLER_STORAGE_CLASS="${STRIMZI_CONTROLLER_STORAGE_CLASS:-}"
export STRIMZI_BROKER_REPLICAS="${STRIMZI_BROKER_REPLICAS:-3}"
export STRIMZI_BROKER_STORAGE_SIZE="${STRIMZI_BROKER_STORAGE_SIZE:-20Gi}"
export STRIMZI_BROKER_STORAGE_CLASS="${STRIMZI_BROKER_STORAGE_CLASS:-}"

# --- Kafka Connect (optional, kafka-connect.yaml) ---
export KAFKA_CONNECT_REPLICAS="${KAFKA_CONNECT_REPLICAS:-1}"

# --- AxonOps agent ---
# AXONOPS_NAMESPACE and AXON_SERVER_ORG_NAME come from
# ../../axonops/axonops-config.env when it is sourced in the same shell.
export AXONOPS_NAMESPACE="${AXONOPS_NAMESPACE:-axonops}"
export AXON_AGENT_ORG="${AXON_AGENT_ORG:-${AXON_SERVER_ORG_NAME:-example}}"
# Not used by a self-hosted server.
export AXON_AGENT_KEY="${AXON_AGENT_KEY:-not-used}"
export AXON_AGENT_CLUSTER_NAME="${AXON_AGENT_CLUSTER_NAME:-$STRIMZI_CLUSTER_NAME}"
export AXON_AGENT_SERVER_HOST="${AXON_AGENT_SERVER_HOST:-axon-server-agent.${AXONOPS_NAMESPACE}.svc.cluster.local}"
export AXON_AGENT_SERVER_PORT="${AXON_AGENT_SERVER_PORT:-${AXON_SERVER_AGENTS_PORT:-1888}}"
# Set to TLS when the server agents port has TLS enabled.
export AXON_AGENT_TLS_MODE="${AXON_AGENT_TLS_MODE:-disabled}"
