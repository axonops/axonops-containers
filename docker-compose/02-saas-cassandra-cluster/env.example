# Example 02 configuration
#
#   cp env.example .env
#   docker compose up -d

# =============================================================================
# REQUIRED — from https://console.axonops.cloud
# =============================================================================

# Your AxonOps organisation, exactly as it appears in the console.
AXONOPS_ORG_NAME=my-organization

# Agent key for that organisation, from your AxonOps Cloud account:
# https://axonops.com/docs/get_started/agent_setup/
# This is a credential. .env is gitignored; keep it that way.
AXONOPS_AGENT_KEY=

# =============================================================================
# CLUSTER
# =============================================================================

# Cluster name shown in AxonOps
#CASSANDRA_CLUSTER_NAME=saas-demo-cluster

# Datacentre name. Each node gets its own rack (rack0, rack1, rack2).
#CASSANDRA_DC=dc1

# Image for the cluster nodes
#CASSANDRA_IMAGE=ghcr.io/axonops/cassandra/cassandra:5.0.8

# Heap per node. 1G is a development value; three nodes at 1G needs roughly
# 5 GB of RAM in total.
#CASSANDRA_HEAP_SIZE=1G
#CASSANDRA_HEAP_NEWSIZE=256M

# Host port for CQL on cassandra-0
#CQL_PORT=9042

# =============================================================================
# AXONOPS ENDPOINT
# =============================================================================

# SaaS endpoint. Change only for a dedicated AxonOps region or for testing
# against a self-hosted axon-server — see example 01 for the self-hosted stack.
#AXONOPS_SERVER_HOST=agents.axonops.cloud
#AXONOPS_SERVER_PORT=443

# NTP host used for the agent's clock-skew check. Agents report a warning if
# they cannot reach one.
#AXONOPS_NTP_HOST=time.google.com
