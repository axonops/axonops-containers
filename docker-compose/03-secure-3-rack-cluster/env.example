# Example 03 configuration
#
#   cp env.example .env
#   docker compose up -d
#
# Everything here has a working default except AXONOPS_ORG_NAME, which you
# should set to something recognisable. Uncomment a line to change it.

# =============================================================================
# AXONOPS PLATFORM
# =============================================================================

# Organisation name shown in the dashboard. The agents on every Cassandra node
# use the same value, so change it here and it changes everywhere.
AXONOPS_ORG_NAME=example

# License key. Empty runs in trial mode, which is enough to evaluate the stack.
#AXONOPS_LICENSE_KEY=

# Credentials for the two AxonOps data stores. Both stay inside the compose
# network. .env is gitignored — keep it that way.
#AXONOPS_DB_PASSWORD=axonops
#AXONOPS_SEARCH_PASSWORD=MyS3cur3P@ss2025

# Heap for the AxonOps data stores.
#AXONOPS_CASSANDRA_HEAP_SIZE=2G
#AXONOPS_OPENSEARCH_HEAP_SIZE=2g

# TLS from axon-server to each data store. Leave CASSANDRA_SSL off unless you
# mount a keystore into axondb-timeseries — see the README.
#AXONOPS_OPENSEARCH_SSL=true
#AXONOPS_CASSANDRA_SSL=false

# =============================================================================
# MONITORED CLUSTER
# =============================================================================

# Cluster name shown in AxonOps. The original stack used "archivage-db".
#CASSANDRA_CLUSTER_NAME=secure-cluster

# Datacentre name. The original stack used "ccu". Each node gets its own rack
# (rack1, rack2, rack3) and rack names are fixed in docker-compose.yaml.
#CASSANDRA_DC=dc1

# Image for the three cluster nodes. The default is a development image on
# purpose: authentication needs the entrypoint support for
# CASSANDRA_AUTHENTICATOR and CASSANDRA_AUTHORIZER, and the current production
# image predates it — it would ignore both variables and start the cluster with
# AllowAllAuthenticator, looking healthy the whole time. The README shows how to
# check in one command. Switch to the production image, below, once the next
# Cassandra release ships.
#CASSANDRA_IMAGE=ghcr.io/axonops/development/cassandra:5.0.8-2.0.31-dev-auth-1
#CASSANDRA_IMAGE=ghcr.io/axonops/cassandra/cassandra:5.0.8

# Per-node sizing. These defaults total roughly 12 GB across the whole stack.
# The original config ran 2g of heap in a 4g container per node; use those if
# you have the memory:
#   CASSANDRA_HEAP_SIZE=2g
#   CASSANDRA_MEM_LIMIT=4g
#CASSANDRA_HEAP_SIZE=1G
#CASSANDRA_MEM_LIMIT=2g
#CASSANDRA_CPUS=2.0
