# Example 01 configuration
#
#   cp env.example .env
#   docker compose up -d

# =============================================================================
# REQUIRED
# =============================================================================

# Organisation name. Shown in the dashboard and used as the agent organisation,
# so the Cassandra agents and axon-server must agree on it.
AXONOPS_ORG_NAME=my-organization

# =============================================================================
# MONITORED CASSANDRA CLUSTER
# =============================================================================

# Cluster name shown in AxonOps
#CASSANDRA_CLUSTER_NAME=demo-cluster

# Image for the monitored nodes.
#
# Default is the development build, because the production repository
# ghcr.io/axonops/cassandra/cassandra is tagged but not published yet — pulling
# from it fails with "denied". Both are the same standalone image: the k8ssandra
# Dockerfile built with INCLUDE_MGMT_API=false.
#
# Once the production repository is published, switch to it and pin a version:
#   CASSANDRA_IMAGE=ghcr.io/axonops/cassandra/cassandra:5.0.8-2.0.31-1.0.0
#CASSANDRA_IMAGE=ghcr.io/axonops/cassandra/cassandra-dev:5.0.8-latest

# Heap per monitored node. 1G is a development value; three nodes at 1G plus the
# AxonOps stack is roughly 8 GB of RAM in total.
#CASSANDRA_HEAP_SIZE=1G
#CASSANDRA_HEAP_NEWSIZE=256M

# =============================================================================
# AXONOPS PLATFORM
# =============================================================================

# License key. Leave empty for trial mode. https://axonops.com
#AXONOPS_LICENSE_KEY=

# axondb-timeseries (Cassandra) password
#AXONOPS_DB_PASSWORD=axonops

# axondb-search (OpenSearch) admin password
#AXONOPS_SEARCH_PASSWORD=MyS3cur3P@ss2025

# Heap for the AxonOps data stores. 4G/4g each is the production minimum.
#AXONOPS_CASSANDRA_HEAP_SIZE=2G
#AXONOPS_OPENSEARCH_HEAP_SIZE=2g

# =============================================================================
# SSL/TLS
# =============================================================================

# Encryption between axon-server and its own data stores, with auto-generated
# self-signed certificates. Leave enabled.
#AXONOPS_CASSANDRA_SSL=true
#AXONOPS_OPENSEARCH_SSL=true
