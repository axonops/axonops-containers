# Example 04 configuration
#
#   cp env.example .env
#   docker compose up -d

# =============================================================================
# REQUIRED
# =============================================================================

# Organisation name. Shown in the dashboard, used as the agent organisation, and
# used by the config container to decide which organisation to configure — the
# Cassandra agent, axon-server and config.yaml must all agree on it.
AXONOPS_ORG_NAME=example

# =============================================================================
# MONITORED CASSANDRA CLUSTER
# =============================================================================

# Cluster name shown in AxonOps. Alert rules are attached to this cluster, so
# the config container is given the same value.
#CASSANDRA_CLUSTER_NAME=demo-cluster

# Image for the monitored node. The default is the full version tag; pin the
# digest instead for anything you care about reproducing exactly:
#   CASSANDRA_IMAGE=ghcr.io/axonops/cassandra/cassandra@sha256:98fbf8106234dedadcc8f979a2a879a84b1a48b61118cb90cf22cf6f0e40c77d
#CASSANDRA_IMAGE=ghcr.io/axonops/cassandra/cassandra:5.0.8-2.0.31-1.1.0

# Heap for the monitored node. 1G is a development value.
#CASSANDRA_HEAP_SIZE=1G
#CASSANDRA_HEAP_NEWSIZE=256M

# =============================================================================
# AXONOPS PLATFORM
# =============================================================================

# License key. Leave empty for trial mode. https://axonops.com
#AXONOPS_LICENSE_KEY=

# axondb-timeseries (Cassandra) password
#AXONOPS_DB_PASSWORD=axonops

# axondb-search (OpenSearch) admin password
#AXONOPS_SEARCH_PASSWORD=MyS3cur3P@ss2025

# Heap for the AxonOps data stores. 4G/4g each is the production minimum.
#AXONOPS_CASSANDRA_HEAP_SIZE=2G
#AXONOPS_OPENSEARCH_HEAP_SIZE=2g

# =============================================================================
# SSL/TLS
# =============================================================================

# TLS from axon-server to axondb-search. The search image generates its own
# self-signed certificates, so this works out of the box. Leave enabled.
#AXONOPS_OPENSEARCH_SSL=true

# TLS from axon-server to axondb-timeseries (CQL). Off, because the
# axondb-timeseries image only enables client encryption when a keystore is
# mounted at CASSANDRA_KEYSTORE_PATH — there is no variable that turns it on by
# itself. Setting this to true without mounting a keystore breaks the
# connection: Cassandra logs "Invalid or unsupported protocol version (22)".
#AXONOPS_CASSANDRA_SSL=false

# =============================================================================
# NOTIFICATION INTEGRATIONS
# =============================================================================

# Only needed if you uncomment the Slack integration in config.yaml. Secrets
# belong here, in .env, which is gitignored — never inline them in config.yaml.
# The config service passes this through to the playbook.
#SLACK_WEBHOOK_URL=
